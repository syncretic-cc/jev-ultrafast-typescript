TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT: the text helper calls OpenAI by default. Credentials stay server-side.
USE_OPENAI=true
OPENAI_API_KEY=
# OpenAI model (default gpt-6-luna, its most efficient model).
OPENAI_MODEL=gpt-6-luna
# Optional reasoning effort (default none).
# OPENAI_REASONING_EFFORT=none
# Set USE_OPENAI=false to use any OpenAI-compatible endpoint instead.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional password typed into password fields. Never sent to a model; keep it out of the goal.
# JEV_PASSWORD=
# Optional Chrome connection overrides (empty = unset). Otherwise Ultrafast finds DevToolsActivePort.
# BU_CDP_WS=ws://127.0.0.1:9222/devtools/browser/<id>
# BU_CDP_URL=http://127.0.0.1:9222
# Optional inspector port for `deno task demo` (default 8766).
# TYPESAFE_DEMO_PORT=8766
